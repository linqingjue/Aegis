{
  "name": "aegis",
  "description": "面向 Claude Code 的核心 skills 库：TDD、调试、协作模式和经过验证的工作流",
  "version": "2.0.8",
  "author": {
    "name": "Aegis Maintainers"
  },
  "homepage": "https://github.com/GanyuanRan/Aegis",
  "repository": "https://github.com/GanyuanRan/Aegis",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ]
      }
    ]
  },
  "keywords": [
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "best-practices",
    "workflows"
  ]
}
